set -euo pipefail

# ---------------------------------------------------------------------------
# Colour palette
# ---------------------------------------------------------------------------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
WHITE='\033[1;37m'
BOLD='\033[1m'
NC='\033[0m'

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------
BASE_DIR=/opt/melvin
VENV_PYTHON="${BASE_DIR}/venv/bin/python"
LOG_DIR="/var/log/melvin"
OLLAMA_HOST="${OLLAMA_HOST:-127.0.0.1}"
OLLAMA_PORT="${OLLAMA_PORT:-11434}"
WEBUI_PORT="${WEBUI_PORT:-5000}"

# ---------------------------------------------------------------------------
# Utility helpers
# ---------------------------------------------------------------------------
info()    { printf "${GREEN}[INFO]${NC}  %s\n" "$*"; }
warn()    { printf "${YELLOW}[WARN]${NC}  %s\n" "$*"; }
error()   { printf "${RED}[ERROR]${NC} %s\n" "$*" >&2; }
success() { printf "${GREEN}[OK]${NC}    %s\n" "$*"; }
pause()   { printf "\n${CYAN}Press ENTER to continue...${NC}"; read -r; }

run_python() {
    local script="$1"; shift
    local args=("$@")
    if [[ -x "${VENV_PYTHON}" ]]; then
        # shellcheck disable=SC1091
        source "${BASE_DIR}/venv/bin/activate" 2>/dev/null || true
        "${VENV_PYTHON}" "${BASE_DIR}/${script}" "${args[@]}" || {
            error "Python script '${script}' exited with error $?"
        }
    else
        warn "Virtual environment not found at ${VENV_PYTHON}. Trying system python3."
        python3 "${BASE_DIR}/${script}" "${args[@]}" 2>/dev/null || {
            error "python3 '${script}' exited with error $?"
        }
    fi
}

check_service() {
    local service="$1"
    if systemctl is-active --quiet "${service}" 2>/dev/null; then
        printf "${GREEN}● ${service} is running${NC}\n"
        return 0
    else
        printf "${RED}○ ${service} is NOT running${NC}\n"
        return 1
    fi
}

print_menu_item() {
