                     || warn "No editor available. Set \$EDITOR variable." ;;
            302) cat "${BASE_DIR}/configs/settings.yaml" 2>/dev/null || warn "Config file not found" ;;
            303) printf "${RED}Reset config to defaults? (yes/no):${NC} "; read -r conf
                 [[ "${conf}" == "yes" ]] && bash "${BASE_DIR}/installer/install.sh" "--config-only" 2>/dev/null \
                     || warn "Manual reset required" ;;
            304) prompt_input "New default model" mdl
                 sed -i "s/default_model:.*/default_model: \"${mdl}\"/" "${BASE_DIR}/configs/settings.yaml" 2>/dev/null
                 success "Default model set to ${mdl}" ;;
            305) prompt_input "New Ollama host" newhost
                 sed -i "s/host: \"[^\"]*\"/host: \"${newhost}\"/" "${BASE_DIR}/configs/settings.yaml" 2>/dev/null
                 OLLAMA_HOST="${newhost}"
                 success "Ollama host set to ${newhost}" ;;
            306) prompt_input "New Ollama port" newport
                 sed -i "s/port: [0-9]*/port: ${newport}/" "${BASE_DIR}/configs/settings.yaml" 2>/dev/null
                 OLLAMA_PORT="${newport}"
                 success "Ollama port set to ${newport}" ;;
            307) "${EDITOR:-nano}" "${BASE_DIR}/configs/cluster.yaml" 2>/dev/null \
                     || warn "Cluster config not found" ;;
            308) if command -v dnf &>/dev/null; then
                     dnf update -y
                 elif command -v apt &>/dev/null; then
                     apt-get update && apt-get upgrade -y
                 elif command -v yum &>/dev/null; then
                     yum update -y
                 else
                     warn "No package manager found"
                 fi ;;
            309) ls "${LOG_DIR}"/*.log 2>/dev/null | while read -r lf; do
                     printf "\n${CYAN}=== %s ===${NC}\n" "${lf}"
                     tail -n 20 "${lf}"
                 done ;;
            310) printf "${RED}Clear all Melvin logs? (yes/no):${NC} "; read -r conf
                 [[ "${conf}" == "yes" ]] && \
                     find "${LOG_DIR}" -name "*.log" -exec truncate -s 0 {} \; && success "All logs cleared" ;;
            311) if [[ -f "${BASE_DIR}/requirements.txt" ]]; then
                     "${VENV_PYTHON}" -m pip install -r "${BASE_DIR}/requirements.txt" --upgrade
                 else
                     warn "requirements.txt not found at ${BASE_DIR}/"
                 fi ;;
            312) printf "${BOLD}Checking Melvin installation...${NC}\n"
                 [[ -d "${BASE_DIR}" ]] && success "BASE_DIR exists" || error "BASE_DIR missing"
                 [[ -x "${VENV_PYTHON}" ]] && success "Python venv OK" || warn "Python venv not found"
                 curl -s "http://${OLLAMA_HOST}:${OLLAMA_PORT}/api/tags" &>/dev/null \
                     && success "Ollama is reachable" || warn "Ollama is NOT reachable"
                 for svc in melvin-webui melvin-cluster melvin-healer; do
                     check_service "${svc}" 2>/dev/null || true
                 done ;;
            313) printf "\n${BOLD}Config Summary:${NC}\n"
                 printf "  Base Dir:     %s\n" "${BASE_DIR}"
                 printf "  Venv Python:  %s\n" "${VENV_PYTHON}"
                 printf "  Ollama:       %s:%s\n" "${OLLAMA_HOST}" "${OLLAMA_PORT}"
                 printf "  Web UI Port:  %s\n" "${WEBUI_PORT}"
                 printf "  Log Dir:      %s\n" "${LOG_DIR}"
                 [[ -f "${BASE_DIR}/configs/settings.yaml" ]] && \
                     grep -E "^\s*(name|version|default_model):" "${BASE_DIR}/configs/settings.yaml" 2>/dev/null ;;
            314) prompt_input "Enable debug mode? (true/false)" dbg
                 sed -i "s/debug:.*/debug: ${dbg}/" "${BASE_DIR}/configs/settings.yaml" 2>/dev/null
                 success "Debug mode set to ${dbg}" ;;
            315) clear; show_banner
                 printf "\n${BOLD}Melvin God Mode${NC} — AI Infrastructure Platform\n"
                 printf "Version: 1.0.0\n"
                 printf "Base Directory: %s\n" "${BASE_DIR}"
                 printf "GitHub: https://github.com/melvin-god-mode\n"
                 printf "\nBuilt with: Ollama, Python, Flask, ChromaDB, faster-whisper\n" ;;
            0|q|Q) return ;;
            *) warn "Invalid option: ${choice}" ;;
        esac
        pause
    done
}

# =============================================================================
# MAIN MENU
# =============================================================================
main_menu() {
    while true; do
        show_banner
        printf "\n${BOLD}${WHITE}  MAIN MENU — SELECT A SECTION${NC}\n\n"
        print_menu_item  1  "AI Tools          (Chat with AI models, stream, multi-turn)"
        print_menu_item  2  "Agent Control     (CoderAgent, ResearchAgent, Swarm…)"
        print_menu_item  3  "Model Manager     (List, pull, delete, update models)"
        print_menu_item  4  "Auto-Code         (Generate, improve, test, document code)"
        print_menu_item  5  "Cluster Control   (Nodes, GPU scheduler, replication)"
        print_menu_item  6  "Web UI            (Start/stop, configure, open browser)"
        print_menu_item  7  "Voice AI          (Voice Jarvis, TTS, microphone)"
        print_menu_item  8  "System Monitoring (CPU, GPU, disk, containers)"
        print_menu_item  9  "Healing           (Auto-healer, reports, config)"
        print_menu_item 10  "Networking Tools  (Nmap, Nikto, Gobuster, DNS, OSINT)"
        print_menu_item 11  "Security Tools    (Hydra, SQLMap, WPScan, audits)"
        print_menu_item 12  "Backup / Restore  (Backup, restore, list, verify)"
        print_menu_item 13  "Settings          (Config, update, logs, about)"
        printf "\n"
        print_menu_item  0  "Quit"
        printf "\n"
        divider
        printf "${YELLOW}Select section:${NC} "
        read -r choice
        case "${choice}" in
            1)  menu_ai_tools ;;
            2)  menu_agent_control ;;
            3)  menu_model_manager ;;
            4)  menu_autocode ;;
            5)  menu_cluster_control ;;
            6)  menu_webui ;;
            7)  menu_voice_ai ;;
            8)  menu_system_monitoring ;;
            9)  menu_healing ;;
            10) menu_networking_tools ;;
            11) menu_security_tools ;;
            12) menu_backup_restore ;;
            13) menu_settings ;;
            0|q|Q|quit|exit)
                clear
                printf "${MAGENTA}${BOLD}  Goodbye from Melvin God Mode.${NC}\n\n"
                exit 0 ;;
            *) warn "Invalid section: ${choice}" ; sleep 1 ;;
        esac
    done
}

# =============================================================================
# ENTRY POINT — handle CLI arguments or drop into interactive menu
# =============================================================================
case "${1:-}" in
    --help|-h)
        printf "Usage: melvin [OPTION]\n"
        printf "  (no args)       Interactive menu\n"
        printf "  --chat MODEL    Quick chat with a model\n"
        printf "  --status        Show service status\n"
        printf "  --version       Show version\n"
        printf "  --help          Show this help\n"
        exit 0 ;;
    --chat)
        model="${2:-llama3}"
        printf "${CYAN}Chatting with %s. Type 'exit' to quit.${NC}\n" "${model}"
        while true; do
            printf "${YELLOW}You:${NC} "; read -r msg
            [[ "${msg}" == "exit" ]] && break
            ollama_chat "${model}" "${msg}"
        done
        exit 0 ;;
    --status)
        printf "${BOLD}Melvin God Mode — Service Status${NC}\n"
        divider
        for svc in ollama melvin-webui melvin-cluster melvin-healer; do
            check_service "${svc}" 2>/dev/null || true
        done
        exit 0 ;;
    --version)
        printf "Melvin God Mode v1.0.0\n"
        exit 0 ;;
    "")
        main_menu ;;
    *)
        error "Unknown option: ${1}"
        printf "Run 'melvin --help' for usage.\n"
        exit 1 ;;
esac
