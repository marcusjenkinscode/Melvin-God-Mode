show_section_banner() {
    local section="$1"
    clear
    local banner_file="${BASE_DIR}/ascii/banners/${section}.txt"
    if [[ -f "${banner_file}" ]]; then
        cat "${banner_file}"
    elif command -v figlet &>/dev/null; then
        figlet -f small "${section}" 2>/dev/null || printf "${BOLD}${CYAN}=== ${section} ===${NC}\n"
    else
        printf "\n${BOLD}${CYAN}╔══════════════════════════════════════════╗${NC}\n"
        printf "${BOLD}${CYAN}║  %-40s  ║${NC}\n" "${section^^}"
        printf "${BOLD}${CYAN}╚══════════════════════════════════════════╝${NC}\n"
    fi
    divider
}

prompt_input() {
    local prompt_msg="$1"
    local var_name="$2"
    printf "${YELLOW}${prompt_msg}${NC}: "
    read -r "${var_name?}"
}

ollama_chat() {
    local model="$1"
    local prompt="$2"
    curl -s -X POST "http://${OLLAMA_HOST}:${OLLAMA_PORT}/api/generate" \
        -H "Content-Type: application/json" \
        -d "{\"model\":\"${model}\",\"prompt\":\"${prompt}\",\"stream\":false}" \
        2>/dev/null | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    print(d.get('response','(no response)'))
except Exception as e:
    print('Error:', e)
" || error "Failed to reach Ollama at ${OLLAMA_HOST}:${OLLAMA_PORT}"
}

ollama_stream() {
    local model="$1"
    local prompt="$2"
    curl -s -N -X POST "http://${OLLAMA_HOST}:${OLLAMA_PORT}/api/generate" \
        -H "Content-Type: application/json" \
        -d "{\"model\":\"${model}\",\"prompt\":\"${prompt}\",\"stream\":true}" \
        2>/dev/null | while IFS= read -r line; do
            [[ -z "${line}" ]] && continue
            python3 -c "
import sys, json
try:
    d = json.loads('${line//\'/\\\'}')
    r = d.get('response','')
    sys.stdout.write(r)
    sys.stdout.flush()
except: pass
" 2>/dev/null || true
        done
    printf "\n"
}

